generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/postgres-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_POSTGRES")
}

enum InstitutionType {
  BANK
  CARD_ISSUER
  BROKER
  WALLET_PROVIDER
  OTHER
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  DIGITAL_WALLET
  CREDIT_CARD
  DEBIT_CARD
  MULTIPLE_CARD
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
  INVESTMENT
}

enum EntryType {
  INCOME
  EXPENSE
  SAVED
}

enum PaymentMethod {
  PIX
  DEBIT
  CASH
  CREDIT_SINGLE
  CREDIT_INSTALLMENT
  BANK_TRANSFER
  BOLETO
  OTHER
}

enum SettlementStatus {
  PENDING
  SETTLED
  CANCELED
}

enum EntryOrigin {
  MANUAL
  RECURRING_GENERATED
  INSTALLMENT_GENERATED
}

enum EntryFrequencyProfile {
  FIXED
  VARIABLE
}

enum InstallmentStatus {
  OPEN
  SETTLED
  CANCELED
}

enum PaymentMethodBehavior {
  PIX
  DEBITO
  CREDITO_A_VISTA
  CREDITO_PARCELADO
  DINHEIRO
  TRANSFERENCIA
  BOLETO
  OUTRO
}

model User {
  id           String                @id
  name         String
  email        String                @unique
  cpf          String?               @unique
  passwordHash String
  role         UserRole              @default(USER)
  isActive     Boolean               @default(true)
  lastLoginAt  DateTime?
  mustChangePassword Boolean         @default(false)
  resetPasswordTokenHash String?     @unique
  resetPasswordExpiresAt DateTime?
  resetPasswordAttempts Int          @default(0)
  resetPasswordBlockedUntil DateTime?
  createdAt    DateTime
  updatedAt    DateTime

  sessions       Session[]
  people         Person[]
  accounts       FinancialAccount[]
  categories     Category[]
  paymentMethods PaymentMethodOption[]
  entries        FinancialEntry[]
  purchases      InstallmentPurchase[]
  installments   Installment[]
  supportTickets SupportTicket[]
}

enum UserRole {
  ADMIN
  USER
}

enum SupportTicketType {
  IMPROVEMENT
  BUG
  TALK_TO_ADMIN
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime
  updatedAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Person {
  id        String           @id
  userId    String?
  name      String
  code      String
  isActive  Boolean
  createdAt DateTime
  updatedAt DateTime

  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  accounts  FinancialAccount[]
  entries   FinancialEntry[]
  purchases InstallmentPurchase[]

  @@unique([userId, code])
  @@index([userId, isActive])
}

model FinancialInstitution {
  id        String             @id
  name      String
  shortName String?
  type      InstitutionType
  isActive  Boolean
  createdAt DateTime
  updatedAt DateTime

  accounts  FinancialAccount[]

  @@unique([name, type])
}

model FinancialAccount {
  id            String                @id
  userId        String?
  name          String
  type          AccountType
  institutionId String?
  ownerPersonId String?
  isShared      Boolean
  currency      String
  initialBalance Decimal?
  creditLimit   Decimal?
  closingDay    Int?
  dueDay        Int?
  isActive      Boolean
  createdAt     DateTime
  updatedAt     DateTime

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  institution   FinancialInstitution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  ownerPerson   Person?               @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)

  entries       FinancialEntry[]
  purchases     InstallmentPurchase[]

  @@index([institutionId])
  @@index([ownerPersonId])
  @@index([userId, isActive])
  @@index([type])
  @@index([isActive])
}

model Category {
  id               String       @id
  userId           String?
  name             String
  type             CategoryType
  color            String?
  icon             String?
  parentCategoryId String?
  isEssential      Boolean
  isActive         Boolean
  createdAt        DateTime
  updatedAt        DateTime

  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentCategory   Category?    @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  childCategories  Category[]   @relation("CategoryHierarchy")

  entries          FinancialEntry[]
  purchases        InstallmentPurchase[]

  @@unique([userId, name, type, parentCategoryId])
  @@index([type])
  @@index([userId, isActive])
  @@index([parentCategoryId])
  @@index([isActive])
}

model PaymentMethodOption {
  id                   String                @id
  userId               String?
  name                 String
  behavior             PaymentMethodBehavior
  paymentMethod        PaymentMethod
  requiresInstallments Boolean
  immediateSettlement  Boolean
  isActive             Boolean
  createdAt            DateTime
  updatedAt            DateTime

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@unique([userId, paymentMethod])
  @@index([userId, isActive])
  @@index([behavior])
  @@index([isActive])
}

model FinancialEntry {
  id               String                @id
  userId           String?
  type             EntryType
  description      String
  amount           Decimal
  eventDate        DateTime
  competenceDate   DateTime
  personId         String
  accountId        String
  categoryId       String?
  paymentMethod    PaymentMethod
  settlementStatus SettlementStatus
  frequencyProfile EntryFrequencyProfile
  isInstallment    Boolean
  notes            String?
  origin           EntryOrigin
  createdAt        DateTime
  updatedAt        DateTime

  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  person           Person                @relation(fields: [personId], references: [id], onDelete: Restrict)
  account          FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category         Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installment      Installment?

  @@index([userId, competenceDate])
  @@index([personId, competenceDate])
  @@index([accountId, competenceDate])
  @@index([categoryId, competenceDate])
  @@index([paymentMethod, competenceDate])
  @@index([eventDate])
}

model InstallmentPurchase {
  id                String           @id
  userId            String?
  description       String
  totalAmount       Decimal
  installmentCount  Int
  installmentAmount Decimal
  purchaseDate      DateTime
  notes             String?
  personId          String
  accountId         String
  categoryId        String
  createdAt         DateTime
  updatedAt         DateTime

  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  person            Person           @relation(fields: [personId], references: [id], onDelete: Restrict)
  account           FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category          Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  installments      Installment[]

  @@index([userId, purchaseDate])
  @@index([personId, purchaseDate])
  @@index([accountId, purchaseDate])
  @@index([categoryId, purchaseDate])
}

model Installment {
  id                    String              @id
  userId                String?
  installmentPurchaseId String
  financialEntryId      String              @unique
  number                Int
  amount                Decimal
  dueDate               DateTime
  competenceDate        DateTime
  status                InstallmentStatus
  createdAt             DateTime
  updatedAt             DateTime

  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  installmentPurchase   InstallmentPurchase @relation(fields: [installmentPurchaseId], references: [id], onDelete: Cascade)
  financialEntry        FinancialEntry      @relation(fields: [financialEntryId], references: [id], onDelete: Cascade)

  @@unique([installmentPurchaseId, number])
  @@index([userId, competenceDate, status])
  @@index([competenceDate, status])
  @@index([dueDate])
}

model SupportTicket {
  id            String              @id
  userId        String
  type          SupportTicketType
  description   String
  status        SupportTicketStatus
  adminResponse String?
  createdAt     DateTime
  updatedAt     DateTime

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, type, createdAt])
}
