DATABASE_URL="postgresql://operador:troque_essa_senha@localhost:5433/operador_financeiro?schema=public"
APP_URL="http://127.0.0.1:3000"

# PostgreSQL local para Docker Compose
POSTGRES_DB=operador_financeiro
POSTGRES_USER=operador
POSTGRES_PASSWORD=troque_essa_senha
DATABASE_URL_POSTGRES="postgresql://operador:troque_essa_senha@localhost:5433/operador_financeiro?schema=public"

# Em produção, configure APP_URL com a URL pública do app.

# Credenciais E2E apenas para desenvolvimento/testes locais.
# Gere/atualize esses usuários com: npm run test:users
E2E_ADMIN_EMAIL="kevin@operador.local"
E2E_ADMIN_PASSWORD="Kevin123!"
E2E_USER_EMAIL="teste@operador.local"
E2E_USER_PASSWORD="Teste@123456"
E2E_RUN_ADMIN_TESTS="false"

# SMTP opcional para envio real de reset de senha
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Operador Financeiro <no-reply@exemplo.com>"
